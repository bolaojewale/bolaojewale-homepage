---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
import IntroCard from "../components/IntroCard.astro";
import ContactsCard from "../components/ContactsCard.astro";
import MyStack from "../components/MyStack.astro";
import AboutMe from "../components/AboutMe.astro";
import Now from "../components/Now.astro";
---

<script>
  import { stagger, animate, type AnimationSequence } from "motion";
  import { loaderAnimation } from "../lib/constants";
  const cards = document.querySelectorAll(".card");

  const sequence = [
    loaderAnimation,
    [
      cards,
      { y: ["40%", "0%"], opacity: [0, 1] },
      {
        type: "spring",
        at: "-0.1",
        delay: stagger(0.3),
      },
    ],
  ];

  animate(sequence as AnimationSequence);
</script>

<Layout
  description="Hello, I'm Bola Ojewale, a cybersecurity engineer passionate about threat detection, security automation, and continual learning."
  title="Bola Ojewale - Cybersecurity Engineer"
>
  <main
    class="text-white m-auto p-2 grid gap-2 max-w-6xl overflow-hidden relative w-full sm:p-4 sm:gap-2 md:grid-cols-2 md:gap-3 md:p-6 lg:h-screen lg:grid-rows-8 lg:grid-cols-4 lg:gap-4 lg:max-h-[800px]"
  >
    <IntroCard />
    <AboutMe />
    <ContactsCard />
    <MyStack />
    <Now />
    <Card
      colSpan="md:col-span-1"
      href="https://cybergardener.com"
      rowSpan="md:row-span-2"
      title="Blog"
    >
      <p class="text-sm">
        Check out my latest articles and insights on cybersecurity, threat detection, and security automation.
      </p>
    </Card>
    <Card colSpan="md:col-span-1" rowSpan="md:row-span-2">
      <div class="h-full flex flex-col justify-between">
        <div class="text-center">
          <p class="text-xs text-gray-400 mb-1">Days Since Last Incident</p>
          <p class="text-4xl font-bold text-primary-500" id="incident-counter">0</p>
        </div>
        <p class="text-xs">
          © 2025 · Forked with ♥️ by Bola Ojewale using
          <a
            class="text-red-500"
            href="https://astro.build/"
            target="_blank">Astro</a
          > from <a
            class="text-red-500"
            href="https://gianmarcocavallo.com//"
            target="_blank">Gianmarco Cavallo</a>.
        </p>
      </div>
    </Card>
    <script>
      // Set your last incident date here (YYYY-MM-DD)
      const lastIncidentDate = new Date('2024-01-01');

      function calculateDaysSinceIncident() {
        const now = new Date();
        // Convert to EST (UTC-5)
        const estOffset = -5 * 60;
        const estTime = new Date(now.getTime() + (estOffset - now.getTimezoneOffset()) * 60000);

        // Set both dates to midnight EST for accurate day counting
        const estToday = new Date(estTime.getFullYear(), estTime.getMonth(), estTime.getDate());
        const incidentDay = new Date(lastIncidentDate.getFullYear(), lastIncidentDate.getMonth(), lastIncidentDate.getDate());

        const diffTime = estToday - incidentDay;
        const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

        return diffDays;
      }

      function updateCounter() {
        const days = calculateDaysSinceIncident();
        const counter = document.getElementById('incident-counter');
        if (counter) {
          counter.textContent = days.toString();
        }
      }

      // Update immediately
      updateCounter();

      // Update at midnight EST
      function scheduleNextUpdate() {
        const now = new Date();
        const estOffset = -5 * 60;
        const estTime = new Date(now.getTime() + (estOffset - now.getTimezoneOffset()) * 60000);

        const tomorrow = new Date(estTime);
        tomorrow.setDate(tomorrow.getDate() + 1);
        tomorrow.setHours(0, 0, 0, 0);

        const msUntilMidnight = tomorrow - estTime;

        setTimeout(() => {
          updateCounter();
          scheduleNextUpdate();
        }, msUntilMidnight);
      }

      scheduleNextUpdate();
    </script>
  </main>
</Layout>
